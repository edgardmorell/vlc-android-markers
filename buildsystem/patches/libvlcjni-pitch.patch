+void
+Java_org_videolan_libvlc_MediaPlayer_nativeSetPitchShift(JNIEnv *env, jobject thiz,
+                                                        jfloat semitones)
+{
+    vlcjni_object *p_obj = VLCJniObject_getInstance(env, thiz);
+    if (!p_obj || !p_obj->u.p_mp || !p_obj->u.p_mp->input.p_resource)
+        return;
+
+    input_resource_t *resource = p_obj->u.p_mp->input.p_resource;
+    audio_output_t *aout = input_resource_HoldAout(resource);
+    if (aout)
+    {
+        var_SetFloat(VLC_OBJECT(aout), "pitch-shift", semitones);
+        input_resource_PutAout(resource, aout);
+    }
+}
