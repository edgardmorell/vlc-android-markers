<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floating_markers"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom|center_horizontal"
    android:layout_marginBottom="72dp"
    android:orientation="horizontal"
    android:padding="5dp"
    android:background="@drawable/floating_markers_background"
    android:visibility="gone"
    android:elevation="16dp">

    <TextView
        android:id="@+id/marker_previous"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="‹"
        android:textColor="#D0D0D0"
        android:textSize="30sp"
        android:background="@android:color/transparent"
        android:contentDescription="Previous marker" />

    <TextView
        android:id="@+id/marker_add"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="＋"
        android:textColor="#D0D0D0"
        android:textSize="28sp"
        android:background="@android:color/transparent"
        android:contentDescription="Create marker" />

    <TextView
        android:id="@+id/marker_next"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="›"
        android:textColor="#D0D0D0"
        android:textSize="30sp"
        android:background="@android:color/transparent"
        android:contentDescription="Next marker" />

    <TextView
        android:id="@+id/marker_menu"
        android:layout_width="40dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="⋮"
        android:textColor="#D0D0D0"
        android:textSize="24sp"
        android:background="@android:color/transparent"
        android:contentDescription="Marker menu" />
</LinearLayout>
