<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floating_markers"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom|center_horizontal"
    android:layout_marginBottom="72dp"
    android:orientation="vertical"
    android:padding="5dp"
    android:background="@drawable/floating_markers_background"
    android:visibility="gone"
    android:elevation="16dp">

    <!-- Navigation et création des marqueurs -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/marker_previous"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="#D0D0D0"
            android:textSize="30sp"
            android:background="@drawable/floating_marker_button_ripple"
            android:contentDescription="Previous marker" />

        <TextView
            android:id="@+id/marker_add"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="＋"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:background="@drawable/floating_marker_button_ripple"
            android:contentDescription="Create marker" />

        <TextView
            android:id="@+id/marker_next"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="›"
            android:textColor="#D0D0D0"
            android:textSize="30sp"
            android:background="@drawable/floating_marker_button_ripple"
            android:contentDescription="Next marker" />

    </LinearLayout>

    <!-- Contrôle de boucle A/B -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/marker_loop_a"
            android:layout_width="48dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="A"
            android:textColor="#999999"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/floating_marker_button_ripple"
            android:contentDescription="Set loop point A" />

        <TextView
            android:id="@+id/marker_loop_b"
            android:layout_width="48dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="B"
            android:textColor="#999999"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/floating_marker_button_ripple"
            android:contentDescription="Set loop point B" />

    </LinearLayout>

</LinearLayout>
